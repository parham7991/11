# ════════════════════════════════════════════════════════════════
# نمونهٔ تنظیمات AI آفلند — این فایل را کپی کنید به `.env.local`
# و مقادیر واقعی را وارد کنید. `.env.local` در git نادیده گرفته می‌شود.
# ════════════════════════════════════════════════════════════════

# سرویس AI (یکی را انتخاب کن: groq | openrouter | gemini | openai | ...)
# برای استفاده از OpenRouter به‌جای Groq:
AI_CHAT_PROVIDER=openrouter

# توکن سرویس (در git منتشر نشود — فقط در .env.local)
AI_CHAT_API_KEY=__YOUR_OPENROUTER_TOKEN__

# نام مدل (وقتی OpenRouter است، مدل رایگان را بده، مثلاً):
AI_CHAT_MODEL=tencent/hy3:free

# تنظیمات اختیاری
# AI_CHAT_API_BASE=https://openrouter.ai/api/v1   # معمولاً خودکار از روی سرویس ست می‌شود
# AI_CHAT_ENABLED=1
# AI_CHAT_TEMPERATURE=0.1
# AI_CHAT_MAX_TOKENS=250
# AI_CHAT_ENABLE_RAG=1
# AI_CHAT_RAG_COUNT=8
