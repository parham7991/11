# ─── API Configuration ──────────────────────────────────────────
NEXT_PUBLIC_SECRET_KEY="yB9!x^4kqQm@Z3#pXfT2$@5vLt!nW*J8z"
NEXT_PUBLIC_PAYLOAD_KEY="iwcs-offl-frontend"
NEXT_PUBLIC_COCKIES="USER_SESSION_RXO_LOCAL"
NEXT_PUBLIC_BASE_URL_SITE="https://offl.vercel.app"
NEXT_PUBLIC_BASE_URL_IMAGE="https://media.iwcs.ir"
NEXT_PUBLIC_BASE_URL_AWS_BUCKET="offl"
NEXT_PUBLIC_BASE_SERVER_API_URL="https://api.iwcs.ir/offl/v1"

# ─── Redis Cache ────────────────────────────────────────────────
REDIS_HOST=192.168.1.46
REDIS_PORT=7617
REDIS_PREFIX=iwcs_offl_ms_frontend_

# ─── AI Chat (OmniRouter Arena Elite) ───────────────────────────
AI_CHAT_PROVIDER=omniroute
AI_CHAT_API_KEY=offl-store-ai

# ─── مدل‌ها ──────────────────────────────────────────────────
AI_CHAT_MODEL=offl-chat-elite
AI_ASSEMBLY_MODEL=offl-assemble-elite
AI_ANALYSIS_MODEL=offl-chat-elite

# ─── آدرس API ────────────────────────────────────────────────
AI_CHAT_API_BASE=https://api.lonz.ir/v1

# ─── تنظیمات استاندارد پروژه ────────────────────────────────
AI_CHAT_ENABLED=1
NEXT_PUBLIC_AI_CHAT_ENABLED=1

AI_CHAT_TEMPERATURE=0.35
AI_CHAT_MAX_TOKENS=2000

# RAG (جستجو در محصولات واقعی آفلند)
AI_CHAT_ENABLE_RAG=1
AI_CHAT_RAG_COUNT=15

# پروکسی (داخل OmniRoute مدیریت می‌شود؛ خاموش باشد)
AI_CHAT_USE_PROXY=0

# ─── Server Mode ────────────────────────────────────────────────
SERVER_MOD=production
