# ════════════════════════════════════════════════════════════════
# نمونهٔ تنظیمات AI آفلند — این فایل را کپی کنید به `.env.local`
# و مقادیر واقعی را وارد کنید. `.env.local` در git نادیده گرفته می‌شود.
# ════════════════════════════════════════════════════════════════

# ─── سرویس AI اصلی (OmniRoute Arena Elite) ────────────────────
AI_CHAT_PROVIDER=omniroute
AI_CHAT_API_KEY=__YOUR_OMNIROUTE_API_KEY__

# ─── مدل‌ها ──────────────────────────────────────────────────
# چت آنلاین
AI_CHAT_MODEL=offl-chat-elite
# اسمبل هوشمند
AI_ASSEMBLY_MODEL=offl-assemble-elite
# تحلیل نهایی اسمبل
AI_ANALYSIS_MODEL=offl-chat-elite

# ─── آدرس API ────────────────────────────────────────────────
AI_CHAT_API_BASE=https://api.lonz.ir/v1

# ─── تنظیمات استاندارد پروژه ────────────────────────────────
AI_CHAT_ENABLED=1
NEXT_PUBLIC_AI_CHAT_ENABLED=1

AI_CHAT_TEMPERATURE=0.35
AI_CHAT_MAX_TOKENS=1000

# RAG (جستجو در محصولات واقعی آفلند)
AI_CHAT_ENABLE_RAG=1
AI_CHAT_RAG_COUNT=10

# پروکسی (داخل OmniRoute مدیریت می‌شود؛ خاموش باشد)
AI_CHAT_USE_PROXY=0

# ─── کلیدهای اختیاری / Override ────────────────────────────────
# اگر بخواهید مدل خاصی از Combo را انتخاب کنید:
# AI_CHAT_MODEL=lmarena/claude-sonnet-4-6
# AI_CHAT_MODEL=lmarena/max
# AI_CHAT_MODEL=lmarena/gemini-3.6-flash
# AI_CHAT_MODEL=lmarena/grok-4.20-multi-agent-beta-0309
# AI_CHAT_MODEL=lmarena/claude-haiku-4-5-20251001
# AI_CHAT_MODEL=arena-agent/agent
