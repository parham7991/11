# ───────────────────────────────────────────────────────────
# 🤖 دستیار هوشمند آفلند (AI Chat)
# فقط ۲ خط لازم است: یک سرویس انتخاب کن + توکنش را بده. تمام!
# (آدرس API و مدل پیش‌فرض خودکار از روی سرویس انتخاب می‌شوند)
#
# سرویس‌های رایگان:  groq | gemini | openrouter | mistral | cerebras
# سرویس‌های ایرانی:  avalai | liara
# سایر:              openai | deepseek | together
AI_CHAT_PROVIDER=groq
AI_CHAT_API_KEY=
#
# ── (اختیاری) فقط اگر خواستی override کنی ──
# AI_CHAT_MODEL=            # مدل خاص (پیش‌فرض = بهترین مدلِ همان سرویس)
# AI_CHAT_API_BASE=         # آدرس API دستی
# AI_CHAT_ENABLED=1
# AI_CHAT_TEMPERATURE=0.4
# AI_CHAT_MAX_TOKENS=800
# AI_CHAT_ENABLE_RAG=1      # جستجو در محصولات آفلند
# AI_CHAT_RAG_COUNT=6
# AI_CHAT_SYSTEM_PROMPT=
#
# ── پروکسی SOCKS5 برای ارتباط با AI (اختیاری) ──
AI_CHAT_USE_PROXY=1
AI_CHAT_PROXY_SCHEME=socks5
AI_CHAT_PROXY_HOST=127.0.0.1
AI_CHAT_PROXY_PORT=8912
AI_CHAT_PROXY_USERNAME=OffLand
AI_CHAT_PROXY_PASSWORD=OFFLAND
# یا به‌جای اجزای بالا، آدرس کامل بده:
# AI_CHAT_PROXY_URL=socks5://OffLand:OFFLAND@127.0.0.1:8912
